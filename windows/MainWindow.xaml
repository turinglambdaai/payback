<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PaybackPaperBrush and friends live in App.xaml's theme dictionaries;
         defining them here on the same element crashes the XAML parser. -->
    <Grid RowSpacing="0" Background="{ThemeResource PaybackPaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- summary bar: 2×2 so a narrow window reflows the tiles instead of
             clipping them off the right edge (matches the compact grid the
             macOS sidebar uses) -->
        <StackPanel Grid.Row="0">
            <Grid ColumnSpacing="12" RowSpacing="6" Margin="20,14,20,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Grid.Row="0">
                    <TextBlock x:Name="TotalSpentLabel" Text="累计投入" FontSize="12" Opacity="0.65" />
                    <TextBlock x:Name="TotalSpentText" Text="—" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0">
                    <TextBlock x:Name="EarnedBackLabel" Text="已赚回" FontSize="12" Opacity="0.65" />
                    <TextBlock x:Name="EarnedBackText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource PaybackEarnBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="1">
                    <TextBlock x:Name="OverallDailyLabel" Text="整体日均" FontSize="12" Opacity="0.65" />
                    <TextBlock x:Name="OverallDailyText" Text="—" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1">
                    <TextBlock x:Name="DeviceCountLabel" Text="设备" FontSize="12" Opacity="0.65" />
                    <TextBlock x:Name="DeviceCountText" Text="0" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="QuipText" Margin="24,0,20,6" FontSize="12" Opacity="0.65" Text="" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            x:Name="StatusBar"
            Margin="20,0,20,0"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational">
            <!-- InfoBar has no IsTextSelectionEnabled of its own; the status
                 copy must leave the screen with the user, so it lives in a
                 selectable TextBlock hosted as the InfoBar content. -->
            <InfoBar.Content>
                <TextBlock
                    x:Name="StatusMessage"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </InfoBar.Content>
        </InfoBar>

        <!-- toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="20,10,20,10">
            <ComboBox x:Name="SortBox" SelectionChanged="SortBox_SelectionChanged" Width="140">
                <ComboBoxItem Content="加入时间" IsSelected="True" />
                <ComboBoxItem Content="日均成本" />
                <ComboBoxItem Content="回本进度" />
            </ComboBox>
            <Button x:Name="AddButton" Content="＋ 添加设备" IsEnabled="False" Click="AddButton_Click" />
            <ComboBox x:Name="LanguageBox" Width="120" SelectionChanged="LanguageBox_SelectionChanged">
                <ComboBoxItem Content="跟随系统" IsSelected="True" />
                <ComboBoxItem Content="中文" />
                <ComboBoxItem Content="English" />
            </ComboBox>
            <Button x:Name="ProButton" Content="激活 Pro" Click="ProButton_Click" />
            <!-- Family menu convention: Check for Updates… and About live
                 together in the Help menu, not as toolbar buttons. -->
            <Button x:Name="HelpButton" Content="帮助">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="MenuCheckUpdates" Click="CheckUpdates_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="U" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuAbout" Click="AboutButton_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!-- device cards -->
        <ScrollViewer Grid.Row="3" Padding="20,0,20,16">
            <StackPanel x:Name="DeviceList" Spacing="10" />
        </ScrollViewer>
    </Grid>
</Window>
